# Base URL of the ChipHealth API (no trailing slash). The client appends /v1/...
VITE_API_BASE_URL=http://127.0.0.1:8787

# Google OAuth Web client id (Google Cloud Console -> Credentials -> OAuth client ID).
# Must be listed in the Worker's GOOGLE_CLIENT_IDS.
VITE_GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Dev-only: serve every /v1 endpoint from in-memory fixtures instead of the real API.
# Also bypasses Google Sign-In (a "Sign in as mock admin" button appears).
VITE_USE_MSW=false
